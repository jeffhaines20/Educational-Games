<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pyromancer: SCORM 1.2 package manifest (template).
  tools/build.py copies this file to the root of dist/pyromancer-scorm.zip, next to
  index.html (the single-file build of the game). One SCO: the whole game.
  The game reports cmi.core.score.raw (percentage of challenges completed, once there
  is progress), cmi.core.lesson_status (incomplete / completed) and keeps progress in
  cmi.suspend_data. The ADL schema files are not bundled, so no xsi:schemaLocation is given.
-->
<manifest identifier="pyromancer" version="1.0"
          xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2">
  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>
  <organizations default="pyromancer-org">
    <organization identifier="pyromancer-org">
      <title>Pyromancer</title>
      <item identifier="pyromancer-item" identifierref="pyromancer-sco" isvisible="true">
        <title>Pyromancer</title>
      </item>
    </organization>
  </organizations>
  <resources>
    <resource identifier="pyromancer-sco" type="webcontent" adlcp:scormtype="sco" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>
